# ---------------------------
# 数据库配置（PostgreSQL/Neon）
# ---------------------------
DATABASE_URL="postgres://<数据库用户>:<数据库密码>@<数据库主机>/<数据库名>?sslmode=require&connection_limit=5"
DATABASE_URL_UNPOOLED="postgresql://<数据库用户>:<数据库密码>@<数据库主机>/<数据库名>?sslmode=require"
PGDATABASE="<数据库名>"
PGHOST="<数据库主机>"
PGHOST_UNPOOLED="<数据库主机>"
PGPASSWORD="<数据库密码>"
PGUSER="<数据库用户>"
POSTGRES_DATABASE="<数据库名>"
POSTGRES_HOST="<数据库主机>"
POSTGRES_PASSWORD="<数据库密码>"
POSTGRES_PRISMA_URL="postgres://<数据库用户>:<数据库密码>@<数据库主机>/<数据库名>?connect_timeout=15&sslmode=require"
POSTGRES_URL="postgres://<数据库用户>:<数据库密码>@<数据库主机>/<数据库名>?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://<数据库用户>:<数据库密码>@<数据库主机>/<数据库名>?sslmode=require"
POSTGRES_URL_NO_SSL="postgres://<数据库用户>:<数据库密码>@<数据库主机>/<数据库名>"
POSTGRES_USER="<数据库用户>"

# ---------------------------
# Coze 平台配置
# ---------------------------
COZE_CLIENT_ID="<Coze 客户端 ID>"
COZE_CLIENT_SECRET="<Coze 客户端密钥>"
COZE_REDIRECT_URI="<应用回调地址>"
COZE_WORKFLOW_ID="<Coze 工作流 ID>"

# ---------------------------
# Coze JWT 认证配置
# ---------------------------
COZE_CLIENT_ID_JWT="<Coze JWT 客户端 ID>"
COZE_PRIVATE_KEY_JWT=`-----BEGIN PRIVATE KEY-----
<JWT 私钥内容>
-----END PRIVATE KEY-----`
COZE_PUBLIC_KEY_ID_JWT="<JWT 公钥 ID>"
COZE_API_BASE_JWT="<Coze API 地址>"
COZE_WORKFLOW_ID_JWT="<Coze JWT 工作流 ID>"
COZE_WWW_BASE="<Coze 官网地址>"

# ---------------------------
# 管理员信息
# ---------------------------
ADMIN_EMAIL="<管理员邮箱>"
ADMIN_PASSWORD="<管理员密码>"
ADMIN_NAME="<管理员名称>" # 可选