// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studentExerciseStatuses StudentExerciseStatus[]
  comments   Comment[] // 用户的所有评论

  @@map("User")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model Exercise {
  id                  String   @id @default(uuid())
  title               String
  difficulty          String
  example_input       String
  example_output      String
  problem_description String
  problem_tag         String

  // 关联答题记录
  answers             StudentExerciseStatus[]
  comments   Comment[] // 题目的所有评论

  @@map("Exercise")
}

model StudentExerciseStatus {
  user        User     @relation(fields: [user_id], references: [id])
  user_id     String
  exercise    Exercise @relation(fields: [exercise_id], references: [id])
  exercise_id String
  status      String   // 未作/正确/错误
  answer      String   // 可存文本或JSON
  last_code   String?  // 新增：最后一次提交的代码
  submit_time DateTime @default(now())

  @@id([user_id, exercise_id])
  @@map("StudentExerciseStatus")
}

model Comment {
  id          String    @id @default(uuid())
  content     String    // Markdown 内容
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  // 关联用户
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  // 关联题目
  exercise    Exercise  @relation(fields: [exerciseId], references: [id])
  exerciseId  String
  // 多级回复
  parent      Comment?  @relation("CommentToReplies", fields: [parentId], references: [id])
  parentId    String?
  replies     Comment[] @relation("CommentToReplies")

  @@map("Comment")
}

model Exam {
  id           String     @id @default(uuid())
  name         String
  description  String?
  category     String?
  difficulty   String?
  duration     Int        // 考试时长（分钟）
  totalScore   Int        // 总分
  passingScore Int        // 及格分
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  
  // 关联题目
  questions    Question[]
  submissions  ExamSubmission[]

  @@map("Exam")
}

model Question {
  id          String   @id @default(uuid())
  examId      String
  title       String
  content     String
  type        String   // 题目类型：SINGLE_CHOICE, MULTIPLE_CHOICE, TRUE_FALSE, FILL_BLANK, ESSAY
  score       Int      // 题目分值
  options     Json?    // 选择题选项（JSON格式）
  answer      String   // 正确答案
  explanation String?  // 答案解析
  orderIndex  Int      // 题目顺序
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // 关联试卷
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("Question")
}

model ExamSubmission {
  id            String   @id @default(uuid())
  examId        String
  studentId     String   // 学生ID
  answers       Json     // 学生答案（JSON格式）
  score         Int?     // 总分
  maxScore      Int      // 满分
  submittedAt   DateTime @default(now()) @map("submitted_at")
  timeUsed      Int      // 用时（秒）
  tabSwitchCount Int     @default(0) // 切屏次数
  
  // 关联试卷
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  
  @@unique([examId, studentId]) // 每个学生每个试卷只能有一条记录
  @@map("ExamSubmission")
}
